{
  "name": "@moth-tools/arch-lens",
  "version": "0.1.0-beta.4",
  "description": "Command line interface for Arch-Lens.",
  "type": "module",
  "bin": {
    "arch-lens": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rimraf dist",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run cli",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@moth-tools/arch-lens-core": "workspace:*",
    "@moth-tools/arch-lens-rules": "workspace:*",
    "cac": "^6.7.14",
    "chokidar": "^3.6.0"
  },
  "devDependencies": {
    "rimraf": "^5.0.5"
  },
  "keywords": [
    "arch-lens",
    "cli",
    "architecture",
    "monorepo"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/katie0109/Arch-Lens.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/katie0109/Arch-Lens#readme",
  "bugs": "https://github.com/katie0109/Arch-Lens/issues"
}
