{
  "name": "@arch-lens/plugins",
  "version": "0.1.0-beta.1",
  "description": "Plugin helpers and shared contracts for Arch-Lens rules.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rimraf dist",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run plugins",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@arch-lens/rules": "workspace:*"
  },
  "devDependencies": {
    "rimraf": "^5.0.5"
  },
  "keywords": [
    "arch-lens",
    "plugins",
    "rules"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/katie0109/Arch-Lens.git",
    "directory": "packages/plugins"
  },
  "homepage": "https://github.com/katie0109/Arch-Lens#readme",
  "bugs": "https://github.com/katie0109/Arch-Lens/issues"
}
