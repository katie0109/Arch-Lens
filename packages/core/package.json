{
  "name": "@moth-tools/arch-lens-core",
  "version": "0.1.0-beta.4",
  "description": "Core engine for Arch-Lens rule orchestration.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rimraf dist",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run core",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@moth-tools/arch-lens-rules": "workspace:*",
    "fast-glob": "^3.3.2",
    "jiti": "^2.7.0",
    "typescript": "^5.4.0"
  },
  "devDependencies": {
    "rimraf": "^5.0.5"
  },
  "keywords": [
    "arch-lens",
    "architecture",
    "monorepo",
    "rules-engine"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/katie0109/Arch-Lens.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/katie0109/Arch-Lens#readme",
  "bugs": "https://github.com/katie0109/Arch-Lens/issues"
}
