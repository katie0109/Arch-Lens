# Dependencies
node_modules

# Build outputs
dist
coverage
*.tsbuildinfo

# Compiled output must never be committed inside src/ (it shadows the .ts sources)
packages/*/src/**/*.js
packages/*/src/**/*.d.ts
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts.map

# Logs
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store

# Temporary
.tmp
.temp

# E2E scratch workspaces
.e2e-workspaces
